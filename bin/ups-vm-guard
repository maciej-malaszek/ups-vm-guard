#!/bin/bash

set -u
set -o pipefail

CONFIG="${UPS_VM_GUARD_CONFIG:-/etc/nut/ups-vm-guard.conf}"

[[ -r "$CONFIG" ]] || {
    echo "ERROR: missing configuration: $CONFIG" >&2
    exit 1
}

# shellcheck disable=SC1090
source "$CONFIG"

: "${UPS_NAME:?UPS_NAME is not configured}"
: "${VM_SHUTDOWN_PERCENT:=30}"
: "${VM_RESTART_PERCENT:=30}"
: "${HOST_SHUTDOWN_PERCENT:=23}"
: "${HOST_SHUTDOWN_DELAY:=30}"
: "${VM_SHUTDOWN_TIMEOUT:=120}"

: "${STATE_DIR:=/run/nut}"
: "${STATE_FILE:=$STATE_DIR/vm-shutdown.state}"
: "${LOCK_FILE:=$STATE_DIR/ups-vm-guard.lock}"

: "${LOG_DIR:=/var/log/nut}"
: "${HOST_SHUTDOWN_TIMER:=nut-host-shutdown.timer}"

SYSTEMCTL="${SYSTEMCTL:-$(command -v systemctl || true)}"
UPSC="${UPSC:-$(command -v upsc || true)}"
VIRSH="${VIRSH:-$(command -v virsh || true)}"
LOGGER="${LOGGER:-$(command -v logger || true)}"

[[ -n "$SYSTEMCTL" ]] || {
    echo "ERROR: systemctl not found" >&2
    exit 1
}

[[ -n "$UPSC" ]] || {
    echo "ERROR: upsc not found" >&2
    exit 1
}

[[ -n "$VIRSH" ]] || {
    echo "ERROR: virsh not found" >&2
    exit 1
}

mkdir -p "$STATE_DIR" "$LOG_DIR"
chmod 0750 "$STATE_DIR" "$LOG_DIR" 2>/dev/null || true

LOG_FILE="$LOG_DIR/ups-vm-guard-$(date '+%Y%m%d').log"

exec 9>"$LOCK_FILE"
flock -n 9 || exit 0


log() {
    local msg="$*"

    printf '%s %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S%z')" \
        "$msg" >> "$LOG_FILE"

    [[ -n "$LOGGER" ]] &&
        "$LOGGER" -t ups-vm-guard -- "$msg" 2>/dev/null ||
        true
}


get_battery() {
    local value

    value=$("$UPSC" "$UPS_NAME" battery.charge 2>/dev/null) || return 1

    [[ "$value" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1

    printf '%s\n' "$value"
}


get_status() {
    "$UPSC" "$UPS_NAME" ups.status 2>/dev/null
}


host_shutdown_pending() {
    "$SYSTEMCTL" is-active --quiet "$HOST_SHUTDOWN_TIMER"
}


cancel_host_shutdown() {
    if host_shutdown_pending; then
        log "Recovery: cancelling pending host shutdown"

        "$SYSTEMCTL" stop "$HOST_SHUTDOWN_TIMER" ||
            log "WARNING: failed to cancel $HOST_SHUTDOWN_TIMER"
    fi
}


get_running_vms() {
    "$VIRSH" list --name --state-running 2>/dev/null |
        sed '/^[[:space:]]*$/d'
}


vm_autostart_enabled() {
    local vm="$1"

    "$VIRSH" dominfo "$vm" 2>/dev/null |
        awk -F: '
            /^Autostart:/ {
                gsub(/[[:space:]]/, "", $2)
                print $2
            }
        ' |
        grep -qx 'enable'
}


get_autostart_running_vms() {
    local vm

    while IFS= read -r vm; do
        [[ -z "$vm" ]] && continue

        vm_autostart_enabled "$vm" &&
            printf '%s\n' "$vm"
    done < <(get_running_vms)
}


is_vm_running() {
    "$VIRSH" domstate "$1" 2>/dev/null |
        grep -qx 'running'
}


save_vm_state() {
    local tmp="${STATE_FILE}.tmp"

    {
        echo '# VMs running when UPS protection shutdown began'
        echo '# Only VMs with libvirt autostart enabled are recorded.'
        get_autostart_running_vms
    } > "$tmp"

    chmod 0640 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$STATE_FILE"

    log "Saved VM restart state:"
    sed 's/^/  /' "$STATE_FILE" >> "$LOG_FILE"
}


request_vm_shutdown() {
    local vm

    log "Requesting graceful shutdown of all running VMs"

    while IFS= read -r vm; do
        [[ -z "$vm" ]] && continue

        log "VM '$vm': virsh shutdown"

        "$VIRSH" shutdown "$vm" >/dev/null 2>&1 ||
            log "WARNING: VM '$vm': graceful shutdown request failed"
    done < <(get_running_vms)
}


wait_for_vms() {
    local deadline
    local vm
    local running

    deadline=$(( $(date +%s) + VM_SHUTDOWN_TIMEOUT ))

    log "Waiting up to ${VM_SHUTDOWN_TIMEOUT}s for VMs to shut down"

    while (( $(date +%s) < deadline )); do
        running=0

        while IFS= read -r vm; do
            [[ -z "$vm" ]] && continue

            running=1
            break
        done < <(get_running_vms)

        if (( running == 0 )); then
            log "All VMs shut down gracefully"
            return 0
        fi

        sleep 5
    done

    log "WARNING: VM shutdown timeout expired"

    return 1
}


force_stop_remaining_vms() {
    local vm

    while IFS= read -r vm; do
        [[ -z "$vm" ]] && continue

        log "VM '$vm': graceful shutdown failed; forcing destroy"

        "$VIRSH" destroy "$vm" >/dev/null 2>&1 ||
            log "ERROR: VM '$vm': virsh destroy failed"
    done < <(get_running_vms)
}


shutdown_vms() {
    if [[ -f "$STATE_FILE" ]]; then
        log "VM shutdown state already exists; not overwriting it"
    else
        save_vm_state
    fi

    request_vm_shutdown
    wait_for_vms || force_stop_remaining_vms
}


restart_saved_vms() {
    local vm
    local started=0

    if [[ ! -f "$STATE_FILE" ]]; then
        log "No saved VM shutdown state; nothing to restart"
        return 0
    fi

    log "Battery recovered; restarting saved VMs"

    while IFS= read -r vm; do
        [[ -z "$vm" || "$vm" =~ ^# ]] && continue

        if ! vm_autostart_enabled "$vm"; then
            log "VM '$vm': autostart is disabled; not restarting"
            continue
        fi

        if is_vm_running "$vm"; then
            log "VM '$vm': already running"
            continue
        fi

        log "VM '$vm': starting"

        if "$VIRSH" start "$vm" >/dev/null 2>&1; then
            ((started += 1))
        else
            log "ERROR: VM '$vm': failed to start"
        fi
    done < "$STATE_FILE"

    rm -f "$STATE_FILE"

    log "VM recovery complete; started $started VM(s)"
}


handle_recovery() {
    local battery="$1"
    local whole="${1%.*}"

    cancel_host_shutdown

    if (( whole >= VM_RESTART_PERCENT )); then
        restart_saved_vms
    else
        log \
            "AC restored but battery is ${battery}%; " \
            "waiting for >= ${VM_RESTART_PERCENT}% before VM restart"
    fi
}


handle_battery() {
    local battery="$1"
    local whole="${1%.*}"

    if (( whole <= VM_SHUTDOWN_PERCENT )); then
        if [[ ! -f "$STATE_FILE" ]]; then
            log \
                "Battery ${battery}% <= ${VM_SHUTDOWN_PERCENT}%; " \
                "initiating VM shutdown"

            shutdown_vms
        else
            log \
                "Battery ${battery}% <= ${VM_SHUTDOWN_PERCENT}%; " \
                "VM shutdown already active"

            [[ -n "$(get_running_vms)" ]] &&
                request_vm_shutdown
        fi
    fi

    battery=$(get_battery) || {
        log "ERROR: unable to re-read battery.charge"
        return 1
    }

    whole="${battery%.*}"

    if (( whole <= HOST_SHUTDOWN_PERCENT )); then
        if host_shutdown_pending; then
            log \
                "Battery ${battery}% <= ${HOST_SHUTDOWN_PERCENT}%; " \
                "host shutdown timer already active"
        else
            log \
                "Battery ${battery}% <= ${HOST_SHUTDOWN_PERCENT}%; " \
                "scheduling host shutdown in ${HOST_SHUTDOWN_DELAY}s"

            "$SYSTEMCTL" start "$HOST_SHUTDOWN_TIMER" &&
                log "Host shutdown timer started" ||
                {
                    log "ERROR: failed to start $HOST_SHUTDOWN_TIMER"
                    return 1
                }
        fi
    fi
}


main() {
    local battery
    local status

    battery=$(get_battery) || {
        log "ERROR: unable to read battery.charge from UPS '$UPS_NAME'"
        exit 1
    }

    status=$(get_status) || {
        log "ERROR: unable to read ups.status from UPS '$UPS_NAME'"
        exit 1
    }

    log "UPS status='$status', battery=${battery}%"

    if [[ "$status" == *OL* ]]; then
        handle_recovery "$battery"

    elif [[ "$status" == *OB* ]]; then
        handle_battery "$battery"

    else
        log \
            "WARNING: UPS status '$status' is neither clearly OL nor OB; " \
            "taking no percentage-based action"
    fi
}


main "$@"